# Corkboard Task Manager - Environment Configuration Example

# ==========================================
# SERVER CONFIGURATION (/server/.env)
# ==========================================
PORT=5050
NODE_ENV=development

# MongoDB Connection String
# Leave empty or omit to automatically use the built-in In-Memory MongoDB for instant zero-config testing!
# For production or persistent storage, provide your MongoDB Atlas / local MongoDB URI:
# MONGODB_URI=mongodb://127.0.0.1:27017/corkboard_tasks
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/corkboard?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=corkboard-tactile-sticky-secret-key-super-secure-2026
JWT_EXPIRES_IN=1h

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# ==========================================
# CLIENT CONFIGURATION (/client/.env)
# ==========================================
# Base API URL (defaults to '/api' when using Vite proxy in local dev)
VITE_API_URL=/api
